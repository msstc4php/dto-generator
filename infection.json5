{
    "$schema": "tools/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 10,
    // Equivalent mutants are ignored below, so the floor sits at the measured level (100 % at end of stage 1) minus one.
    "minMsi": 99,
    "minCoveredMsi": 99,
    "logs": {
        "text": "var/infection/infection.log",
        "json": "var/infection/infection.json"
    },
    "mutators": {
        "@default": true,
        // Equivalent: a cache of ancestor compositions; recomputing gives the same result.
        "AssignCoalesce": {
            "ignore": [
                "MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\AllOfResolver::ancestor",
            ],
        },
        // Equivalent: isset()-only seen-maps, so the stored value is never read.
        "TrueValue": {
            "ignore": [
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ClassModel::__construct",
                "MSSTC4PHP\\DtoGenerator\\Application\\Service\\Model\\Build\\Registry::abandon",
                "MSSTC4PHP\\DtoGenerator\\Application\\Service\\Model\\Build\\Registry::skip",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\EnumModel::__construct",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\UnionType::__construct",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\AttributeArgument::assertWellFormed",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Schema\\Schema::assertUniqueTypes",
                "MSSTC4PHP\\DtoGenerator\\Application\\Service\\Schemas\\Load\\GraphBuilder::markFailed",
                "MSSTC4PHP\\DtoGenerator\\Application\\Service\\Schemas\\Load\\GraphBuilder::markUnloadable",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Diagnostic\\Diagnostics::add",
                "MSSTC4PHP\\DtoGenerator\\Application\\Service\\Model\\Build\\Action::__invoke",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\TypeMapper::reference",
                "MSSTC4PHP\\DtoGenerator\\Application\\Service\\Schemas\\Load\\GraphBuilder::propagateOwners"
            ]
        },
        // Equivalent: the substr() offsets stay within the string, so it never returns false on 7.4, and
        // preg_replace() only returns null on a regex error.
        "CastString": {
            "ignore": [
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ClassName::fromFqcn",
                // Equivalent: json_encode() with JSON_INVALID_UTF8_SUBSTITUTE never returns false for a JSON value.
                "MSSTC4PHP\\DtoGenerator\\Domain\\Shared\\DefaultValue::toJson",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\Identifier::normalizeQualifiedName",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Schema\\JsonPointer::segments",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Schema\\Reference::target",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Shared\\Path::directory",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Shared\\Path::normalize",
                "MSSTC4PHP\\DtoGenerator\\Application\\Config\\PhpConstraint::lowerBound",
                // file_get_contents() of a file just found, json_encode() of plain arrays and getcwd() do not fail.
                "MSSTC4PHP\\DtoGenerator\\Infrastructure\\Writer\\FilesystemWriter::plan",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\EnumBuilder::show",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\NameResolver::enumCaseName",
                "MSSTC4PHP\\DtoGenerator\\Infrastructure\\Writer\\FilesystemWriter::readManifest",
                "MSSTC4PHP\\DtoGenerator\\Presentation\\Cli\\JsonReport::encode",
                "MSSTC4PHP\\DtoGenerator\\DtoGenerator::console"
            ]
        },
        // Equivalent: defensive throws whose preconditions the constructors guarantee.
        "Throw_": {
            "ignore": [
                "MSSTC4PHP\\DtoGenerator\\Domain\\Shared\\AbstractEnum::tryFrom",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Target\\Capability::minimumVersion",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ArgumentValue::constantName",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ArgumentValue::className"
            ]
        },
        "InstanceOf_": {
            "ignore": [
                // Config loading reports an error whenever it returns no config or target.
                "MSSTC4PHP\\DtoGenerator\\Application\\Service\\Generate\\Action::__invoke",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Shared\\AbstractEnum::tryFrom",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ArgumentValue::className"
            ]
        },
        // Equivalent for real constraints (and for DefaultFit's numeric bounds): numeric strings compare numerically (only a leading-zero version,
        // which Composer never emits, would differ), and an equal candidate changes nothing.
        "CastInt": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Application\\Config\\PhpConstraint::lowerBound", "MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\DefaultFit::inRange"] },
        "GreaterThan": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Application\\Config\\PhpConstraint::lowerBound"] },
        // Equivalent: the key only has to be unique, and "Item" suffixes are all alike, so the order of the parts is irrelevant.
        "Concat": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Application\\Service\\Model\\Build\\Action::inline", "MSSTC4PHP\\DtoGenerator\\Domain\\Schema\\ReferenceUse::key", "MSSTC4PHP\\DtoGenerator\\Infrastructure\\Writer\\FilesystemWriter::temporaryPath"] },
        // Equivalent: any unique name in the target's directory works for the temporary file.
        "ConcatOperandRemoval": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Infrastructure\\Writer\\FilesystemWriter::temporaryPath"] },
        "LessThan": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Application\\Config\\PhpConstraint::lowestMinor"] },
        // Equivalent: every default passed to stringList() has at most one item.
        "ArrayOneItem": { "ignoreSourceCodeByRegex": [".*return \\$default;.*"] },
        // Equivalent: enum items are already JSON values; the map only narrows the type for PHPStan.
        "UnwrapArrayMap": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\SchemaParser::applyStructural"] },
        // Equivalent: the result is only iterated.
        "UnwrapArrayValues": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Domain\\Schema\\Schema::subschemas"] },
        // Equivalent: preg_split() only returns false on a regex error, ini_set() cannot fail for serialize_precision, and
        // pMaybeMultiline() keeps the parent's default for $trailingComma only for signature compatibility; it ignores it.
        // DtoGenerator::withoutAutoExit(): with auto-exit on, the run would end the PHPUnit process itself.
        "FalseValue": { "ignore": ["MSSTC4PHP\\DtoGenerator\\DtoGenerator::withoutAutoExit", "MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\NameResolver::words", "MSSTC4PHP\\DtoGenerator\\Domain\\Shared\\Json::floatToString", "MSSTC4PHP\\DtoGenerator\\Infrastructure\\Emitter\\GeneratedCodePrinter::pMaybeMultiline"] },
        // Equivalent: with one side null, either order of the coalesce yields the other side.
        "Coalesce": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\TypeMapper::tightest"] },
        // Equivalent: the json_decode depth only matters for 512-level nesting.
        "IncrementInteger": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Infrastructure\\Environment\\ComposerJsonPhpConstraint::read", "MSSTC4PHP\\DtoGenerator\\Infrastructure\\Writer\\FilesystemWriter::temporaryPath"] },
        "DecrementInteger": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Infrastructure\\Environment\\ComposerJsonPhpConstraint::read", "MSSTC4PHP\\DtoGenerator\\Infrastructure\\Writer\\FilesystemWriter::temporaryPath"] },
        // Equivalent: the refinement comes from TypeMapper, which always starts an integer range with "int<".
        // Equivalent: config loading reports an error whenever it returns no config or target.
        // Equivalent for the suite: without it, run() would end the PHPUnit process itself; fclose() of a handle that
        // could not be locked only frees a descriptor.
        "MethodCallRemoval": { "ignore": ["MSSTC4PHP\\DtoGenerator\\DtoGenerator::withoutAutoExit", "MSSTC4PHP\\DtoGenerator\\Infrastructure\\Writer\\DirectoryLocks::open"] },
        "LogicalOr": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Application\\Service\\Generate\\Action::__invoke"] },
        "PregMatchRemoveCaret": { "ignore": ["MSSTC4PHP\\DtoGenerator\\Domain\\Builder\\DefaultFit::inRange"] }
    },
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=unit,integration,functional"
}
