{
    "$schema": "tools/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 10,
    // Equivalent mutants are ignored below, so the floor sits at the measured level (100 % at end of stage 1) minus one.
    "minMsi": 99,
    "minCoveredMsi": 99,
    "logs": {
        "text": "var/infection/infection.log",
        "json": "var/infection/infection.json"
    },
    "mutators": {
        "@default": true,
        // Equivalent: isset()-only seen-maps, so the stored value is never read.
        "TrueValue": {
            "ignore": [
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ClassModel::__construct",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\EnumModel::__construct",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\UnionType::__construct",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\AttributeArgument::assertWellFormed",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Schema\\Schema::assertUniqueTypes"
            ]
        },
        // Equivalent: substr() offsets are within the validated name, so it never returns false on 7.4.
        "CastString": {
            "ignore": [
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ClassName::fromFqcn",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\Identifier::normalizeQualifiedName"
            ]
        },
        // Equivalent: defensive throws whose preconditions the constructors guarantee.
        "Throw_": {
            "ignore": [
                "MSSTC4PHP\\DtoGenerator\\Domain\\Shared\\AbstractEnum::tryFrom",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Target\\Capability::minimumVersion",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ArgumentValue::constantName",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ArgumentValue::className"
            ]
        },
        "InstanceOf_": {
            "ignore": [
                "MSSTC4PHP\\DtoGenerator\\Domain\\Shared\\AbstractEnum::tryFrom",
                "MSSTC4PHP\\DtoGenerator\\Domain\\Model\\ArgumentValue::className"
            ]
        }
    },
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=unit"
}
