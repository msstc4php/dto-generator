<?xml version="1.0"?>
<!-- Only what an extension or a caller of the generator may use is public API: the SPI (Contract and the Domain types
     it hands out, as the Symfony bridge's deptrac layer CoreSpi names them) and the entry points with what they return.
     A message counts by the first class it names, the one that changed; "(?s)" lets it span the lines of a changed
     constant value. -->
<roave-bc-check
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="tools/vendor/roave/backward-compatibility-check/Resources/schema.xsd">
    <baseline>
        <ignored-regex>#(?s)^(?!(?:(?!MSSTC4PHP\\).)*MSSTC4PHP\\DtoGenerator\\(?:Contract\\|Domain\\(?:Model|Schema|Diagnostic|Target|Shared|Exception)\\|DtoGenerator\b|Application\\Service\\Generate\\(?:Action|Input|Mode|Output|Status|WritePlan|GeneratedFile|FileChange)\b)).*$#</ignored-regex>
    </baseline>
</roave-bc-check>
