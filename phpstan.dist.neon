parameters:
    level: max
    phpVersion: 70400
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    bootstrapFiles:
        - vendor/autoload.php
    paths:
        - src/
        - tests/
    disallowedFunctionCalls:
        -
            function:
                - 'var_dump()'
                - 'print_r()'
                - 'dump()'
                - 'dd()'
            message: 'debug artefact'
        -
            function: 'error_log()'
            message: 'the library reports through diagnostics, not the PHP error log'
        -
            function:
                - 'str_contains()'
                - 'str_starts_with()'
                - 'str_ends_with()'
                - 'array_is_list()'
                - 'get_debug_type()'
                - 'fdiv()'
                - 'preg_last_error_msg()'
                - 'get_resource_id()'
                - 'enum_exists()'
                - 'fsync()'
                - 'fdatasync()'
                - 'json_validate()'
                - 'mb_str_pad()'
                - 'str_increment()'
                - 'str_decrement()'
                - 'array_find()'
                - 'array_find_key()'
                - 'array_any()'
                - 'array_all()'
                - 'mb_trim()'
                - 'mb_ltrim()'
                - 'mb_rtrim()'
                - 'mb_ucfirst()'
                - 'mb_lcfirst()'
                - 'array_first()'
                - 'array_last()'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4 (phpVersion: 70400 does not catch functions present in the analysing runtime)'
    disallowedClasses:
        -
            class:
                - 'Stringable'
                - 'ValueError'
                - 'WeakMap'
                - 'Attribute'
                - 'PhpToken'
                - 'UnhandledMatchError'
                - 'Fiber'
                - 'ReturnTypeWillChange'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4'
