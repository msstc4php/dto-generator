parameters:
    level: max
    phpVersion: 70400
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    bootstrapFiles:
        - vendor/autoload.php
    paths:
        - src/
        - tests/
    disallowedFunctionCalls:
        -
            function:
                - 'var_dump()'
                - 'print_r()'
                - 'dump()'
                - 'dd()'
            message: 'debug artefact'
        -
            function: 'error_log()'
            message: 'the library reports through diagnostics, not the PHP error log'
        -
            function:
                - 'str_contains()'
                - 'str_starts_with()'
                - 'str_ends_with()'
                - 'array_is_list()'
                - 'get_debug_type()'
                - 'fdiv()'
                - 'preg_last_error_msg()'
                - 'get_resource_id()'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4 (phpVersion: 70400 does not catch functions present in the analysing runtime)'
    disallowedClasses:
        -
            class:
                - 'Stringable'
                - 'ValueError'
                - 'WeakMap'
            message: 'PHP 8.0+ only; the package runs on PHP 7.4'
